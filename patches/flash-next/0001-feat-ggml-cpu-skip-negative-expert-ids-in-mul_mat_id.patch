From b2ee67b6ede856db94d84cabe023ae712a9168c9 Mon Sep 17 00:00:00 2001
From: onewireout <301024764+onewireout@users.noreply.github.com>
Date: Fri, 23 Oct 2026 21:21:07 -0500
Subject: [PATCH 1/4] feat(ggml-cpu): skip negative expert ids in mul_mat_id

A negative id skips the expert and writes a zero output row. Lets a GPU expert cache hand the CPU only the experts it does not hold.

Adds test-mul-mat-id-skip.
---
 ggml/src/ggml-cpu/ggml-cpu.c   |   8 +-
 ggml/src/ggml-cpu/repack.cpp   |   8 +-
 tests/CMakeLists.txt           |   1 +
 tests/test-mul-mat-id-skip.cpp | 131 +++++++++++++++++++++++++++++++++
 4 files changed, 146 insertions(+), 2 deletions(-)
 create mode 100644 tests/test-mul-mat-id-skip.cpp

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 4c33369..acbefca 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1652,7 +1652,13 @@ static void ggml_compute_forward_mul_mat_id(
             for (int id = 0; id < n_ids; ++id) {
                 const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
 
-                assert(i02 >= 0 && i02 < n_as);
+                // negative id: skip the expert, its output row is zero
+                if (i02 < 0) {
+                    memset((char *) dst->data + id*nb1 + iid1*nb2, 0, ne0*sizeof(float));
+                    continue;
+                }
+
+                assert(i02 < n_as);
 
                 MMID_MATRIX_ROW(i02, matrix_row_counts[i02]) = (struct mmid_row_mapping) {id, iid1};
                 matrix_row_counts[i02] += 1;
diff --git a/ggml/src/ggml-cpu/repack.cpp b/ggml/src/ggml-cpu/repack.cpp
index 2632ae3..7f8e433 100644
--- a/ggml/src/ggml-cpu/repack.cpp
+++ b/ggml/src/ggml-cpu/repack.cpp
@@ -4855,7 +4855,13 @@ template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PAR
                     const int32_t i02 =
                         *(const int32_t *) ((const char *) ids->data + iid1 * ids->nb[1] + id * ids->nb[0]);
 
-                    GGML_ASSERT(i02 >= 0 && i02 < n_as);
+                    // negative id: skip the expert, its output row is zero
+                    if (i02 < 0) {
+                        memset((char *) op->data + id * op->nb[1] + iid1 * op->nb[2], 0, op->ne[0] * sizeof(float));
+                        continue;
+                    }
+
+                    GGML_ASSERT(i02 < n_as);
 
                     MMID_MATRIX_ROW(i02, matrix_row_counts[i02]) = { id, iid1 };
                     matrix_row_counts[i02] += 1;
