From 4b31eeaddc27cd1dad28123dbdaac09fcf20d79f Mon Sep 17 00:00:00 2001
From: onewireout <301024764+onewireout@users.noreply.github.com>
Date: Fri, 23 Oct 2026 23:05:56 -0500
Subject: [PATCH 2/4] feat(moe-cache): per-token timing of expert uploads

LLAMA_MOE_CACHE_TIMING logs wait, plan and upload time per token for small ubatches, every 100 tokens.
---
 src/llama-moe-cache.cpp | 52 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 51 insertions(+), 1 deletion(-)

diff --git a/src/llama-moe-cache.cpp b/src/llama-moe-cache.cpp
index 4d3596b..8550575 100644
--- a/src/llama-moe-cache.cpp
+++ b/src/llama-moe-cache.cpp
@@ -6,6 +6,7 @@
 #include "ggml-cpp.h"
 
 #include <algorithm>
+#include <cstdlib>
 #include <stdexcept>
 #include <unordered_map>
 #include <vector>
@@ -227,6 +228,16 @@ struct llama_moe_cache::impl {
         size_t bytes  = 0;
     };
 
+    // LLAMA_MOE_CACHE_TIMING: time the copies of small ubatches, the uploads are waited for so they can be timed
+    struct timing {
+        int64_t t_wait   = 0; // waiting for the selected experts
+        int64_t t_plan   = 0; // slot planning and upload submission
+        int64_t t_upload = 0; // until the uploads are done
+        size_t  calls    = 0;
+        size_t  misses   = 0;
+        size_t  bytes    = 0;
+    };
+
     static constexpr int64_t max_batch = 32;
 
     int32_t n_expert_used;
@@ -235,6 +246,9 @@ struct llama_moe_cache::impl {
     stats stats_large;
     stats stats_copy;  // experts copied from the cache for large batches
 
+    const bool timing_on = getenv("LLAMA_MOE_CACHE_TIMING") != nullptr;
+    timing tm;
+
     std::vector<device> devices;
     std::vector<group> groups;
     std::vector<layer> layers;
@@ -579,10 +593,14 @@ struct llama_moe_cache::impl {
         }
         GGML_ASSERT(ggml_is_contiguous(sel));
 
+        const int64_t t0 = timing_on ? ggml_time_us() : 0;
+
         ids.resize(ggml_nelements(sel));
         ggml_backend_tensor_get_async(backend, sel, ids.data(), 0, ggml_nbytes(sel));
         ggml_backend_synchronize(backend);
 
+        const int64_t t1 = timing_on ? ggml_time_us() : 0;
+
         size_t n_hit = 0;
         if (!g.slru.plan(il, ids.data(), ids.size(), fills, n_hit)) {
             GGML_ABORT("the MoE cache is too small for the experts selected in layer %d", il);
@@ -605,17 +623,49 @@ struct llama_moe_cache::impl {
             }
         }
 
-        stats & st = ids.size() <= (size_t) 8*n_expert_used ? stats_small : stats_large;
+        const bool small = ids.size() <= (size_t) 8*n_expert_used;
+
+        stats & st = small ? stats_small : stats_large;
         st.hits   += n_hit;
         st.misses += fills.size();
         st.bytes  += bytes;
 
+        if (timing_on && small) {
+            const int64_t t2 = ggml_time_us();
+            ggml_backend_synchronize(backend);
+            const int64_t t3 = ggml_time_us();
+
+            tm.t_wait   += t1 - t0;
+            tm.t_plan   += t2 - t1;
+            tm.t_upload += t3 - t2;
+            tm.calls    += 1;
+            tm.misses   += fills.size();
+            tm.bytes    += bytes;
+
+            log_timing();
+        }
+
         // the next copy synchronizes the backend before it changes the slot map again
         ggml_backend_tensor_set_async(backend, dst, src->data, 0, ggml_nbytes(src));
 
         return true;
     }
 
+    // every 100 tokens, as one call per cached layer and token
+    void log_timing() {
+        int64_t n_cached = 0;
+        for (const auto & l : layers) {
+            n_cached += l.ig >= 0;
+        }
+        const double n_tok = (double) tm.calls / std::max<int64_t>(n_cached, 1);
+        if (n_tok < 100) {
+            return;
+        }
+        LLAMA_LOG_WARN("llama_moe_cache: per token: wait %.2f ms, plan %.2f ms, upload %.2f ms (%.1f misses, %.2f MiB)\n",
+            tm.t_wait/1e3/n_tok, tm.t_plan/1e3/n_tok, tm.t_upload/1e3/n_tok, tm.misses/n_tok, tm.bytes/1024.0/1024.0/n_tok);
+        tm = {};
+    }
+
     void log_stats() const {
         auto log = [](const char * name, const stats & st) {
             const size_t n = st.hits + st.misses;
-- 
